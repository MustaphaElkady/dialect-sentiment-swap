APP_NAME="Dialect Sentiment Swap"
APP_VERSION="0.1.0"

ENVIRONMENT="local"
PROJECT_ROOT="."


######### DATA ##############
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"

RAW_TRAIN_FILE="train.xlsx"
RAW_EVAL_FILE="eval.xlsx"

PROCESSED_TRAIN_FILE="train.jsonl"
PROCESSED_EVAL_FILE="eval.jsonl"

DATASET_VALIDATION_REPORT_FILE="dataset_validation_report.md"

TRAINING_PREVIEW_OUTPUT_DIR="experiments/previews"
TRAINING_PREVIEW_FILE="training_examples_preview.jsonl"
TRAINING_PREVIEW_MAX_EXAMPLES=5

##########  SEQ2SEQ MODEL ##########
TRAIN_MODEL_NAME="UBC-NLP/AraT5v2-base-1024"

MAX_SOURCE_LENGTH=256
MAX_TARGET_LENGTH=128

BASELINE_OUTPUT_DIR="experiments/baselines"
BASELINE_PREDICTIONS_FILE="arat5v2_baseline_predictions.jsonl"
BASELINE_MAX_EXAMPLES=20

GENERATION_MAX_NEW_TOKENS=128
GENERATION_NUM_BEAMS=4

##########  CAUSAL MODEL ##########
CAUSAL_MODEL_NAME="Qwen/Qwen2.5-3B-Instruct"
CAUSAL_OUTPUT_DIR="experiments/causal_baselines"
CAUSAL_PREDICTIONS_FILE="qwen2_5_3b_instruct_predictions.jsonl"
CAUSAL_MAX_EXAMPLES=10

CAUSAL_MAX_NEW_TOKENS=128
CAUSAL_TEMPERATURE=0.7
CAUSAL_TOP_P=0.9


LLAMAFACTORY_DATA_DIR="data/llamafactory"
LLAMAFACTORY_TRAIN_FILE="sentiment_swap_train.json"
LLAMAFACTORY_EVAL_FILE="sentiment_swap_val.json"
LLAMAFACTORY_DATASET_INFO_FILE="dataset_info.json"

FINETUNE_MODEL_NAME="Qwen/Qwen2.5-7B-Instruct"
FINETUNE_OUTPUT_DIR="/content/drive/MyDrive/dialect-sentiment-swap/models/qwen2_5_7b_sentiment_swap_qlora"